# All keys can also be set through the UI at /settings.
# Anything here is used as a fallback when the corresponding DB row is empty.

# ── Required (2 keys) ────────────────────────────────────────────────
# Gemini for scene splitting. Get one free at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# GeminiGen.AI — images (nano-banana-2) + video (Veo) + TTS (Gemini TTS).
# One key covers the entire generation phase. No rate limit on the core models.
# Sign up at https://geminigen.ai → Service Integration → API keys
GEMINIGEN_API_KEY=

# ── Optional / backup providers ──────────────────────────────────────
# Only needed if you switch away from Gemini TTS (TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FAL_API_KEY=

# Absolute path to ffmpeg if it isn't already in your PATH.
# macOS: /opt/homebrew/bin/ffmpeg
# Windows: C:\\ffmpeg\\bin\\ffmpeg.exe
FFMPEG_PATH=

# ── Storage location ─────────────────────────────────────────────────
# Where runs are written. Leave empty to use the default (~/.conveyer-isabell/runs).
ISABELL_DATA_DIR=
